// =============================================================================
// Title:          LOLBAS - PowerShell AV Exclusion Commands
// Type:           Threat Hunting
// Platform:       Microsoft Defender XDR - Advanced Hunting
// Description:    Finds PowerShell adding Microsoft Defender exclusions or turning off
//                 Defender protections (Add-MpPreference / Set-MpPreference). Attackers
//                 do this just before dropping or running a payload, so it can be
//                 scanned less or not at all.
//
// MITRE ATT&CK:   T1562.001 - Impair Defenses: Disable or Modify Tools; T1059.001 - PowerShell
// Data sources:   DeviceProcessEvents
// References:     https://learn.microsoft.com/en-us/powershell/module/defender/add-mppreference
//                 https://attack.mitre.org/techniques/T1562/001/
//
// How to use:     Run as is. Look at what was excluded (ExclusionPath folders like
//                 Temp, AppData or Public are a red flag) and what launched PowerShell.
// Tuning / FPs:   IT tools (Intune, SCCM, RMM agents, GPO scripts) legitimately set
//                 exclusions: add their parent process to ExcludedParents. Misses:
//                 Base64-encoded commands (-EncodedCommand), exclusions set through the
//                 registry, Group Policy or Intune, and heavily abbreviated parameters
//                 (e.g. -ExclusionP); hunt those in DeviceRegistryEvents separately.
//
// Author:         xWhiff
// Created:        2026-07-03
// Updated:        2026-11-17 - header and comments; 30d lookback; Add-MpPreference,
//                 pwsh and renamed PowerShell added; more exclusion/disable parameters
// Version:        1.1
// =============================================================================

// ---- Inputs ----
let lookback = 30d;                   // how far back to search
// PowerShell binaries. "pwsh.dll" is PowerShell 7's original file name, so a renamed pwsh.exe is still caught.
let PowerShellNames = dynamic(["powershell.exe", "pwsh.exe", "powershell_ise.exe", "pwsh.dll"]);
let DefenderCmdlets = dynamic(["Add-MpPreference", "Set-MpPreference"]);
// Parameters that add exclusions or switch protections off.
let TamperParameters = dynamic([
    "ExclusionPath", "ExclusionProcess", "ExclusionExtension", "ExclusionIpAddress",
    "DisableRealtimeMonitoring", "DisableIOAVProtection", "DisableBehaviorMonitoring",
    "DisableIntrusionPreventionSystem", "DisableScriptScanning", "DisableBlockAtFirstSeen",
    "DisableArchiveScanning"]);
let ExcludedParents = dynamic([]);    // e.g. "AgentExecutor.exe" (Intune) once confirmed legitimate

// ---- Step 1: PowerShell running a Defender preference cmdlet ----
// Checks the original file name too, so a renamed copy of PowerShell is still caught.
DeviceProcessEvents
| where Timestamp > ago(lookback)
| where FileName in~ (PowerShellNames) or ProcessVersionInfoOriginalFileName in~ (PowerShellNames)
| where ProcessCommandLine has_any (DefenderCmdlets)
// ---- Step 2: Only commands that add an exclusion or disable a protection ----
| where ProcessCommandLine has_any (TamperParameters)
| where InitiatingProcessFileName !in~ (ExcludedParents)
// List which parameters were used, so the analyst doesn't have to read the whole command line.
| extend ParametersUsed = extract_all(@"(?i)-((?:Exclusion|Disable)\w+)", ProcessCommandLine)
// ---- Output ----
// One row per command, newest first.
| project Timestamp, DeviceName, AccountName, ParametersUsed, ProcessCommandLine,
          FileName, InitiatingProcessFileName, InitiatingProcessCommandLine, InitiatingProcessParentFileName
| sort by Timestamp desc
