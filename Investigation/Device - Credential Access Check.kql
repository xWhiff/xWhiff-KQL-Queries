// =============================================================================
// Title:          Device - Credential Access Check
// Type:           Investigation
// Platform:       Microsoft Defender XDR - Advanced Hunting
// Description:    Starts from one device and lists signs that someone tried to steal
//                 credentials from it: LSASS memory dumps (comsvcs MiniDump, procdump,
//                 Mimikatz and similar), processes opening LSASS, SAM / SYSTEM /
//                 SECURITY hive saves, NTDS.dit copies (ntdsutil, shadow copies),
//                 browser password store access, Kerberos ticket tools, and dump
//                 files written to disk.
//
// MITRE ATT&CK:   T1003.001 - OS Credential Dumping: LSASS Memory;
//                 T1003.002 - OS Credential Dumping: Security Account Manager;
//                 T1003.003 - OS Credential Dumping: NTDS;
//                 T1555.003 - Credentials from Web Browsers;
//                 T1558.003 - Steal or Forge Kerberos Tickets: Kerberoasting
// Data sources:   DeviceInfo, DeviceProcessEvents, DeviceEvents, DeviceFileEvents
// References:     https://attack.mitre.org/techniques/T1003/
//
// How to use:     Set deviceName and lookback. Treat any LSASS dump, hive save or
//                 NTDS copy as serious: assume the passwords of everyone who logged
//                 on to this device are compromised and escalate.
// Tuning / FPs:   Backup software and admins troubleshooting crashes (procdump on
//                 other processes) can match: check the target in the command line.
//                 "LSASS opened" rows depend on what Defender chose to record; add
//                 legitimate security tools to ExcludedLsassReaders.
//
// Author:         xWhiff
// Created:        2026-11-18
// Updated:        2026-11-18 - initial version
// Version:        1.0
// =============================================================================

// ---- Inputs ----
let deviceName = "pc01.contoso.com";  // REPLACE: device to check (short name also works)
let lookback = 7d;                    // how far back to search
// Well-known credential theft tools, by file name.
let CredentialTools = dynamic(["mimikatz.exe", "procdump.exe", "procdump64.exe", "lazagne.exe", "rubeus.exe",
                               "nanodump.exe", "pypykatz.exe", "safetykatz.exe", "sharpdump.exe", "dumpert.exe"]);
// Processes that legitimately open LSASS (Windows itself and Defender).
let ExcludedLsassReaders = dynamic(["MsMpEng.exe", "MsSense.exe", "SenseIR.exe", "csrss.exe", "wininit.exe",
                                    "services.exe", "svchost.exe", "lsm.exe", "WmiPrvSE.exe"]);

// ---- Step 1: Find the device's ID ----
let devId = toscalar(
    DeviceInfo
    | where Timestamp > ago(lookback + 7d)
    | where DeviceName =~ deviceName or DeviceName startswith strcat(deviceName, ".")
    | summarize arg_max(Timestamp, DeviceId)
    | project DeviceId);

// ---- Step 2: Credential-theft commands and tools ----
// Each command line is labelled with what it does; anything unlabelled is dropped.
let Commands =
    DeviceProcessEvents
    | where Timestamp > ago(lookback)
    | where DeviceId == devId
    | extend Technique = case(
        FileName in~ (CredentialTools) or ProcessVersionInfoOriginalFileName in~ (CredentialTools),
            "Known credential tool",
        ProcessCommandLine has "comsvcs" and ProcessCommandLine has_any ("MiniDump", "#24"),
            "LSASS dump (comsvcs)",
        ProcessCommandLine has "lsass" and ProcessCommandLine has_any ("-ma", "minidump", "Out-Minidump", "dump"),
            "LSASS dump",
        ProcessCommandLine has_any ("sekurlsa", "lsadump", "kerberos::", "privilege::debug"),
            "Mimikatz commands",
        FileName =~ "reg.exe" and ProcessCommandLine has "save" and ProcessCommandLine has_any (@"hklm\sam", @"hklm\system", @"hklm\security",
                                                                                         @"HKEY_LOCAL_MACHINE\SAM", @"HKEY_LOCAL_MACHINE\SYSTEM", @"HKEY_LOCAL_MACHINE\SECURITY"),
            "Registry hive saved (SAM / SYSTEM / SECURITY)",
        ProcessCommandLine has "ntdsutil" and ProcessCommandLine has_any ("ifm", "create full"),
            "NTDS.dit copy (ntdsutil)",
        ProcessCommandLine has "HarddiskVolumeShadowCopy" and ProcessCommandLine has_any ("ntds.dit", @"\config\SAM", @"\config\SYSTEM"),
            "Credential file copied from shadow copy",
        ProcessCommandLine has_any ("Login Data", "logins.json", "key4.db", "Web Data") and FileName !in~ ("chrome.exe", "msedge.exe", "firefox.exe", "brave.exe"),
            "Browser password store accessed",
        ProcessCommandLine has_any ("kerberoast", "asktgt", "asktgs", "Invoke-Kerberoast"),
            "Kerberos ticket theft",
        "")
    | where isnotempty(Technique)
    | project Timestamp, Technique, Detail = ProcessCommandLine, Account = AccountName,
              ByProcess = InitiatingProcessFileName, ByCommandLine = InitiatingProcessCommandLine;

// ---- Step 3: Processes that opened LSASS ----
// OpenProcessApiCall with FileName lsass.exe = another process asked for a handle to LSASS memory.
let LsassAccess =
    DeviceEvents
    | where Timestamp > ago(lookback)
    | where DeviceId == devId
    | where ActionType == "OpenProcessApiCall" and FileName =~ "lsass.exe"
    | where InitiatingProcessFileName !in~ (ExcludedLsassReaders)
    | project Timestamp, Technique = "LSASS opened by another process", Detail = tostring(AdditionalFields),
              Account = InitiatingProcessAccountName, ByProcess = InitiatingProcessFileName,
              ByCommandLine = InitiatingProcessCommandLine;

// ---- Step 4: Dump and hive files written to disk ----
let DumpFiles =
    DeviceFileEvents
    | where Timestamp > ago(lookback)
    | where DeviceId == devId
    | where ActionType in ("FileCreated", "FileRenamed")
    | where (FileName endswith ".dmp" and FileName has "lsass")
         or (FileName in~ ("sam", "system", "security", "sam.save", "system.save", "security.save", "sam.hiv", "system.hiv")
             and not(FolderPath has @"\System32\config\"))                          // Windows' own live hives
         or (FileName =~ "ntds.dit" and not(FolderPath has @"\Windows\NTDS\"))
    | project Timestamp, Technique = "Credential dump file written", Detail = FolderPath,
              Account = InitiatingProcessAccountName, ByProcess = InitiatingProcessFileName,
              ByCommandLine = InitiatingProcessCommandLine;

// ---- Output ----
// One list, oldest first.
union isfuzzy=true Commands, LsassAccess, DumpFiles
| project Timestamp, Technique, Detail, Account, ByProcess, ByCommandLine
| sort by Timestamp asc
