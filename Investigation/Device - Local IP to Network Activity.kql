// =============================================================================
// Title:          Device - Local IP to Network Activity
// Type:           Investigation
// Platform:       Microsoft Defender XDR - Advanced Hunting
// Description:    Starts from a local or VPN IP in an alert, works out which device had it
//                 at the time, and lists every network connection that device made around the
//                 alert, with a three-level process tree (grandparent > parent > process).
//                 Flags watched IPs, a target domain, and public IPs with no URL.
//
// MITRE ATT&CK:   N/A - general network triage for any alert
// Data sources:   DeviceNetworkEvents, DeviceNetworkInfo, DeviceProcessEvents
// References:     https://learn.microsoft.com/en-us/defender-xdr/advanced-hunting-devicenetworkevents-table
//
// How to use:     Fill in the REPLACE inputs: localIP, alertTime (UTC) and watchIPs; domain
//                 is optional. Widen window if the alert time is approximate. Results are in
//                 time order; look at Flag first.
// Tuning / FPs:   If no device is found, the IP may have changed hands (DHCP / VPN pool):
//                 check the alert time and widen the DeviceNetworkInfo range in Step 1.
//
// Author:         xWhiff
// Created:        2026-11-14
// Updated:        2026-11-17 - header added (query unchanged)
// Version:        1.0
// =============================================================================

// ---- Inputs ----
let localIP = "192.0.2.10";                     // REPLACE: local / VPN IP from the alert
let alertTime = datetime(2026-01-01 00:00:00);  // REPLACE: alert time (UTC)
let window = 10m;                               // 10 mins either side
let domain = "";                                // optional - leave "" if none
let watchIPs = dynamic(["203.0.113.1", "203.0.113.2", "203.0.113.3"]);  // REPLACE: external IPs of interest
// ---- Step 1: resolve local IP to device ----
// First try the network events themselves (best for VPN IPs)
let devFromEvents = toscalar(
    DeviceNetworkEvents
    | where Timestamp between ((alertTime - window) .. (alertTime + window))
    | where LocalIP == localIP
    | summarize arg_min(abs(Timestamp - alertTime), DeviceId)
    | project DeviceId);
// Fallback: DeviceNetworkInfo adapter records
let devFromInfo = toscalar(
    DeviceNetworkInfo
    | where Timestamp between ((alertTime - 1d) .. (alertTime + 1h))
    | mv-expand ipinfo = todynamic(IPAddresses)
    | where tostring(ipinfo.IPAddress) == localIP
    | summarize arg_max(Timestamp, DeviceId)
    | project DeviceId);
let devId = coalesce(devFromEvents, devFromInfo);
// ---- Step 2: grandparent lookup for a 3-level process tree ----
let grandparents = DeviceProcessEvents
| where DeviceId == devId
| where Timestamp between ((alertTime - 7d) .. (alertTime + window))
| project DeviceId,
    ParentPid = ProcessId,
    ParentCreated = ProcessCreationTime,
    GrandParentName = InitiatingProcessFileName,
    GrandParentCmd = InitiatingProcessCommandLine;
// ---- Step 3: all connections around the alert ----
DeviceNetworkEvents
| where DeviceId == devId
| where Timestamp between ((alertTime - window) .. (alertTime + window))
| join kind=leftouter grandparents on DeviceId,
    $left.InitiatingProcessParentId == $right.ParentPid,
    $left.InitiatingProcessParentCreationTime == $right.ParentCreated
| extend Flag = case(
    RemoteIP in (watchIPs), strcat("WATCH IP: ", RemoteIP),
    isnotempty(domain) and RemoteUrl has domain, "TARGET DOMAIN",
    RemoteIPType == "Public" and isempty(RemoteUrl), "Public IP, no URL",
    ""),
    ProcessTree = strcat(GrandParentName, " > ", InitiatingProcessParentFileName, " > ", InitiatingProcessFileName)
| project Timestamp, DeviceName, Flag, ActionType, LocalIP, RemoteUrl, RemoteIP, RemotePort, Protocol,
    ProcessTree, InitiatingProcessCommandLine, InitiatingProcessAccountName,
    InitiatingProcessFolderPath, InitiatingProcessSHA256, GrandParentCmd
| sort by Timestamp asc
