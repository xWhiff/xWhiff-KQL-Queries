// =============================================================================
// Title:          Device - Persistence Check
// Type:           Investigation
// Platform:       Microsoft Defender XDR - Advanced Hunting
// Description:    Starts from one device and lists every new way something was set up
//                 to run automatically: Run / RunOnce keys, Winlogon and Image File
//                 Execution Options changes, new services, new or changed scheduled
//                 tasks, files dropped in Startup folders and WMI event subscriptions.
//
// MITRE ATT&CK:   T1547.001 - Registry Run Keys / Startup Folder; T1547.004 - Winlogon Helper DLL;
//                 T1546.012 - Image File Execution Options Injection; T1543.003 - Windows Service;
//                 T1053.005 - Scheduled Task; T1546.003 - WMI Event Subscription
// Data sources:   DeviceInfo, DeviceRegistryEvents, DeviceEvents, DeviceFileEvents
// References:     https://attack.mitre.org/tactics/TA0003/
//
// How to use:     Set deviceName and lookback (or narrow it to the days around an
//                 alert). For each row, check What (name of the entry) and Detail
//                 (what it runs): paths in Temp, AppData, ProgramData or Public, and
//                 script hosts like powershell or mshta, are red flags.
// Tuning / FPs:   Software installs and updates create services, tasks and Run keys
//                 all the time: add the installer / updater to ExcludedProcesses
//                 once checked. Windows servicing processes are excluded already.
//
// Author:         xWhiff
// Created:        2026-11-18
// Updated:        2026-11-18 - initial version
// Version:        1.0
// =============================================================================

// ---- Inputs ----
let deviceName = "pc01.contoso.com";  // REPLACE: device to check (short name also works)
let lookback = 7d;                    // how far back to look for new persistence
// Windows servicing and Defender itself change these locations legitimately.
let ExcludedProcesses = dynamic(["TiWorker.exe", "TrustedInstaller.exe", "MsMpEng.exe", "MpSigStub.exe"]);
// Registry locations that make something run automatically.
let PersistenceKeys = dynamic([
    @"\CurrentVersion\Run", @"\CurrentVersion\RunOnce", @"\CurrentVersion\RunServices",
    @"\CurrentVersion\Policies\Explorer\Run", @"\Windows NT\CurrentVersion\Winlogon",
    @"\Windows NT\CurrentVersion\Image File Execution Options", @"\Windows NT\CurrentVersion\Windows"]);

// ---- Step 1: Find the device's ID ----
let devId = toscalar(
    DeviceInfo
    | where Timestamp > ago(lookback + 7d)
    | where DeviceName =~ deviceName or DeviceName startswith strcat(deviceName, ".")
    | summarize arg_max(Timestamp, DeviceId)
    | project DeviceId);

// ---- Step 2: Registry autorun entries set ----
// has_any matches the key paths as whole words, so RunOnce is listed separately from Run.
let RegistryPersistence =
    DeviceRegistryEvents
    | where Timestamp > ago(lookback)
    | where DeviceId == devId
    | where ActionType == "RegistryValueSet"
    | where RegistryKey has_any (PersistenceKeys)
    // Winlogon, IFEO and the Windows key change all the time: keep only the values that launch something.
    | where not(RegistryKey has @"\Winlogon") or RegistryValueName in~ ("Shell", "Userinit", "Taskman", "AppSetup")
    | where not(RegistryKey has @"\Image File Execution Options") or RegistryValueName in~ ("Debugger", "GlobalFlag")
    | where not(RegistryKey endswith @"\Windows NT\CurrentVersion\Windows") or RegistryValueName in~ ("AppInit_DLLs", "Load", "Run")
    | where InitiatingProcessFileName !in~ (ExcludedProcesses)
    | project Timestamp, Mechanism = "Registry autorun", What = RegistryValueName,
              Detail = strcat(RegistryKey, " = ", RegistryValueData),
              Account = InitiatingProcessAccountName, ByProcess = InitiatingProcessFileName,
              ByCommandLine = InitiatingProcessCommandLine;

// ---- Step 3: Services installed, scheduled tasks created / changed, WMI subscriptions ----
// The details (service name, task name, what it runs) are in AdditionalFields.
let EventPersistence =
    DeviceEvents
    | where Timestamp > ago(lookback)
    | where DeviceId == devId
    | where ActionType in ("ServiceInstalled", "ScheduledTaskCreated", "ScheduledTaskUpdated", "WmiBindEventFilterToConsumer")
    | where InitiatingProcessFileName !in~ (ExcludedProcesses)
    | extend Fields = parse_json(AdditionalFields)
    | project Timestamp,
              Mechanism = case(ActionType == "ServiceInstalled", "New service",
                               ActionType == "WmiBindEventFilterToConsumer", "WMI subscription",
                               "Scheduled task"),
              What = coalesce(tostring(Fields.ServiceName), tostring(Fields.TaskName), FileName),
              Detail = tostring(AdditionalFields),
              Account = InitiatingProcessAccountName, ByProcess = InitiatingProcessFileName,
              ByCommandLine = InitiatingProcessCommandLine;

// ---- Step 4: Files dropped in a Startup folder ----
let StartupFolder =
    DeviceFileEvents
    | where Timestamp > ago(lookback)
    | where DeviceId == devId
    | where FolderPath has @"\Start Menu\Programs\Startup\"
    | where ActionType in ("FileCreated", "FileModified", "FileRenamed")
    | project Timestamp, Mechanism = "Startup folder", What = FileName, Detail = FolderPath,
              Account = InitiatingProcessAccountName, ByProcess = InitiatingProcessFileName,
              ByCommandLine = InitiatingProcessCommandLine;

// ---- Output ----
// One list, oldest first.
union isfuzzy=true RegistryPersistence, EventPersistence, StartupFolder
| project Timestamp, Mechanism, What, Detail, Account, ByProcess, ByCommandLine
| sort by Timestamp asc
